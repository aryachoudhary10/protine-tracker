{
  "manifest_version": 3,
  "name": "Rephrase",
  "version": "1.0.0",
  "description": "Rewrite selected text in place, in any text field, on any site.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Rephrase" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "rephrase-selection": {
      "suggested_key": { "default": "Ctrl+Shift+R", "mac": "Command+Shift+R" },
      "description": "Rewrite the selected text"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "rephrase@aryaai.online", "strict_min_version": "121.0" }
  }
}
