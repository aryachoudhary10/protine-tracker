# ---------------------------------------------------------------------------
# Rephrase — server environment
#
# You need AT LEAST ONE provider. The route tries them in the order listed in
# lib/providers/index.js (Cloudflare, then Groq, then OpenRouter) and falls
# through on rate limits and outages.
# ---------------------------------------------------------------------------

# --- Cloudflare Workers AI (primary) ---------------------------------------
# Free: 10,000 neurons/day (~1,300 rewrites), no card required.
# Account ID: dash.cloudflare.com -> Workers & Pages -> right sidebar.
# API token:  My Profile -> API Tokens -> Create -> "Workers AI" template.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional override. Default: @cf/meta/llama-4-scout-17b-16e-instruct
CF_MODEL=

# --- Groq (fallback) --------------------------------------------------------
# Free: 30 req/min. 70B model is 1,000 req + 100k tokens/day;
# llama-3.1-8b-instant is far more generous at 14,400 req + 500k tokens/day.
# Key: console.groq.com/keys
GROQ_API_KEY=
# Optional override. Default: llama-3.3-70b-versatile
GROQ_MODEL=

# --- OpenRouter (second fallback, optional) ---------------------------------
# Free: 50 req/day, or 1,000/day after a one-time $10 top-up.
# Key: openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override. Default: deepseek/deepseek-chat-v3:free
OPENROUTER_MODEL=

# --- Rate limiting (strongly recommended) -----------------------------------
# Without these the endpoint is unlimited and anyone can burn your free tier.
# Free DB at console.upstash.com -> copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuning (all optional, defaults shown)
RATE_WINDOW_SECONDS=60
RATE_MAX_PER_WINDOW=12
RATE_MAX_PER_DAY=200
PROVIDER_TIMEOUT_MS=20000

# Your deployed origin. Only used as an OpenRouter attribution header.
SITE_URL=
